{
  "name": "mp4-gop-cutter-wasm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/copy-assets.mjs",
    "dev": "npm run prepare:assets && vite --host 127.0.0.1",
    "build": "npm run prepare:assets && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "tsx": "4.20.6",
    "@types/node": "24.9.1",
    "@playwright/test": "1.56.1"
  }
}
